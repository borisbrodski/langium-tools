---
import '../styles/global.css';
import { GUIDES, SITE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'langium-tools — issues, file generation, and tests for Langium DSLs. One list of diagnostics, in-memory generators that preserve timestamps, and snapshot tests for generated code.',
} = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/logo.png" />
    <meta name="theme-color" content="#0c1110" />
    <link rel="canonical" href={new URL(path, SITE.domain).href} />
    <script is:inline>
      (() => {
        const url = new URLSearchParams(location.search).get('theme');
        const saved = localStorage.getItem('theme');
        const preferred = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = url ?? saved ?? preferred;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="logo" href="/">
          <img src="/img/logo.png" alt="" width="28" height="28" />
          <span class="logo-name">langium-<span class="brand-text">tools</span></span>
        </a>
        <button class="nav-burger" type="button" aria-label="Open menu" data-nav-toggle>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <nav class="links" data-nav>
          <a href="/#quickstart">Getting started</a>
          <div class="navmenu">
            <a href="/issues/" class="navmenu-top" aria-haspopup="true">Guides <span class="caret" aria-hidden="true">▾</span></a>
            <div class="navmenu-panel" role="menu">
              {GUIDES.map((guide) => (
                <a role="menuitem" href={guide.href} aria-current={path === guide.href ? 'page' : undefined}>{guide.title}</a>
              ))}
            </div>
          </div>
          <a href="/#why">Why</a>
          <a href={SITE.typedoc}>API</a>
        </nav>
        <div class="actions">
          <button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
            <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a class="gh" href={SITE.github} aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <a class="btn btn-primary btn-sm" href="/#quickstart">Get started</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container foot">
        <div class="foot-brand">
          <img src="/img/logo.png" alt="" width="28" height="28" />
          <div>
            <div class="logo-name">langium-<span class="brand-text">tools</span></div>
            <p>Helpers for Langium DSLs · MIT</p>
          </div>
        </div>
        <div class="foot-cols">
          <div>
            <h4>Project</h4>
            <a href={SITE.github}>GitHub</a>
            <a href={SITE.npm}>npm</a>
            <a href={SITE.typedoc}>Typedoc API</a>
            <a href={`${SITE.github}/issues`}>Issues</a>
          </div>
          <div>
            <h4>Guides</h4>
            {GUIDES.map((guide) => <a href={guide.href}>{guide.title}</a>)}
          </div>
          <div>
            <h4>On this site</h4>
            <a href="/#why">Why use it</a>
            <a href="/#quickstart">Getting started</a>
            <a href="/#modules">Modules</a>
            <a href="/#fit">Where it fits</a>
          </div>
        </div>
      </div>
      <div class="container foot-note">
        © {new Date().getFullYear()} Boris Brodski · langium-tools {SITE.version} · hosted at langium-tools.openbrod.org
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: var(--header-bg); backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
      }
      .nav { display: flex; align-items: center; gap: 28px; height: 62px; }
      .logo { display: flex; align-items: center; gap: 10px; }
      .logo img { object-fit: contain; border-radius: 6px; }
      .logo-name { font-weight: 750; font-size: 1.02rem; color: var(--text); letter-spacing: -.01em; }
      .links { display: flex; gap: 22px; margin-left: auto; align-items: center; }
      .links > a, .navmenu-top { color: var(--text-2); font-size: .92rem; font-weight: 500; }
      .links > a:hover, .navmenu-top:hover { color: var(--text); }
      .links a[aria-current='page'] { color: var(--text); }
      .navmenu { position: relative; }
      .navmenu-top .caret { font-size: .7em; opacity: .7; }
      .navmenu-panel {
        position: absolute; top: calc(100% + 10px); left: -14px; min-width: 220px; z-index: 60;
        display: none; flex-direction: column; padding: 8px;
        background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
        box-shadow: 0 12px 34px rgba(0,0,0,.28);
      }
      .navmenu-panel::before { content: ''; position: absolute; top: -12px; left: 0; right: 0; height: 12px; }
      .navmenu:hover .navmenu-panel, .navmenu:focus-within .navmenu-panel { display: flex; }
      .links .navmenu-panel a { padding: 6px 10px; border-radius: 6px; font-size: .88rem; color: var(--text-2); }
      .links .navmenu-panel a:hover { background: var(--surface-2); color: var(--text); }
      .actions { display: flex; align-items: center; gap: 14px; }
      .gh { color: var(--text-2); display: inline-flex; }
      .gh:hover { color: var(--text); }
      .btn-sm { padding: 7px 15px; font-size: .87rem; }
      .nav-burger {
        display: none; margin-left: auto;
        appearance: none; background: transparent; color: var(--text-2);
        border: 1px solid var(--border-strong); border-radius: 8px;
        width: 34px; height: 34px; align-items: center; justify-content: center; cursor: pointer;
      }
      @media (max-width: 860px) {
        .nav-burger { display: inline-flex; }
        .links {
          display: none; position: absolute; top: 62px; left: 0; right: 0;
          margin: 0; padding: 8px 16px 16px; flex-direction: column; align-items: stretch; gap: 4px;
          background: var(--bg); border-bottom: 1px solid var(--border);
        }
        .links.open { display: flex; }
        .navmenu-panel { position: static; display: flex; box-shadow: none; border: 0; background: transparent; padding: 0 0 0 8px; min-width: 0; }
        .navmenu-panel::before { display: none; }
        .actions .btn-sm { display: none; }
      }

      .site-footer { border-top: 1px solid var(--border); background: var(--bg-2); margin-top: 40px; }
      .foot { display: flex; gap: 60px; padding: 44px 24px 28px; flex-wrap: wrap; }
      .foot-brand { display: flex; gap: 12px; align-items: flex-start; max-width: 280px; }
      .foot-brand img { border-radius: 6px; }
      .foot-brand p { font-size: .82rem; margin: 4px 0 0; color: var(--text-3); }
      .foot-cols { display: flex; gap: 48px; flex-wrap: wrap; margin-left: auto; }
      .foot-cols h4 { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-3); margin: 0 0 10px; }
      .foot-cols a { display: block; color: var(--text-2); font-size: .9rem; padding: 3px 0; }
      .foot-cols a:hover { color: var(--text); }
      .foot-note { padding: 16px 24px 26px; font-size: .8rem; color: var(--text-3); border-top: 1px solid var(--border); }
    </style>
    <script>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const el = document.documentElement;
        const next = el.dataset.theme === 'light' ? 'dark' : 'light';
        el.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
      document.querySelector('[data-nav-toggle]')?.addEventListener('click', () => {
        document.querySelector('[data-nav]')?.classList.toggle('open');
      });
      document.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const box = btn.closest('.codebox');
          const pre = box?.querySelector('pre');
          if (!pre) return;
          navigator.clipboard.writeText(pre.innerText ?? '');
          const label = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = label; }, 1400);
        });
      });
    </script>
  </body>
</html>
