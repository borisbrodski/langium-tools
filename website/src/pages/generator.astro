---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { SITE } from '../lib/site';

const basic = `import {
  GeneratedContentManager,
  type GeneratorManager,
} from 'langium-tools/generator';

const manager = new GeneratedContentManager();

function generate(gen: GeneratorManager<Model>) {
  const model = gen.getModel();
  gen.createFile(
    'src-gen/' + model.name + '.ts',
    '// Generated. Do not edit.\\nexport const name = ' + JSON.stringify(model.name) + ';\\n',
  );
  gen.createFile(
    'src/' + model.name + '.ts',
    'export const name = ' + JSON.stringify(model.name) + ';\\n',
    { overwrite: false },
  );
}

for (const model of models) {
  generate(manager.generatorManagerFor(model));
}

await manager.writeToDisk('./generated');`;

const context = `function generate(gen: GeneratorManager) {
  const model = gen.getModel();
  const document = gen.getDocument();          // LangiumDocument, if the AST was parsed
  const workspace = gen.getWorkspaceURI();     // which workspace folder contains it
  const localPath = gen.getDocumentLocalPath(); // path inside that folder, '/' separators
}`;

const workspaces = `const manager = new GeneratedContentManager([
  'file:///workspace/app',
  'file:///workspace/lib',
]);`;

const targets = `manager.addTarget({ name: 'once', overwrite: false });

gen.createFile('Model.ts', generated, { target: 'once' });
gen.createFile('Model.ts', generated); // default target, overwrite true

await manager.writeToDisk('./src-gen');          // default target
await manager.writeToDisk('./src', 'once');      // the "once" target`;

const clean = `// Delete files in the output directory that this generation did not produce.
await manager.cleanAndWriteToDisk('./src-gen');

// Same thing, explicit:
await manager.writeToDisk('./src-gen', undefined, true);`;
---
<Base
  title="Code generation — langium-tools"
  description="Collect generated files in memory with GeneratedContentManager, then write them to disk only when the content or the overwrite flag says to."
>
  <article class="doc">
    <header class="doc-hero container">
      <div class="kicker">langium-tools/generator</div>
      <h1>Code generation</h1>
      <p class="lead">
        A generator should decide the files. The filesystem should be a later step.
        <span class="inline-code">GeneratedContentManager</span> collects every file in
        memory, from as many models as you have, and writes them when you ask.
      </p>
    </header>

    <div class="container">
      <h2>Why keep it in memory</h2>
      <ul>
        <li>Tests compare the map of files. They do not need a temp directory for the happy path.</li>
        <li>Two models that emit the same path with different text fail immediately, with both document paths in the error.</li>
        <li>Unchanged files are not rewritten, so timestamps stay put and file watchers stay quiet.</li>
        <li>A file marked <span class="inline-code">overwrite: false</span> is created if it is missing and left alone if someone has edited it.</li>
      </ul>

      <h2>The usual shape</h2>
      <p>
        One manager for the run. One <span class="inline-code">GeneratorManager</span> per model.
        <span class="inline-code">createFile</span> records a path relative to the output directory.
      </p>
      <CodeBlock code={basic} filename="generate.ts" />

      <h2>What the generator can see</h2>
      <p>
        The manager hangs off the AST node. If that node was parsed by Langium,
        <span class="inline-code">$document</span> is set and the helpers below resolve.
      </p>
      <CodeBlock code={context} filename="context.ts" />
      <p>
        Pass workspace directory URIs into the constructor when a document should be
        described by a path inside a workspace rather than by its full URI.
        <span class="inline-code">getDocumentLocalPath</span> uses <span class="inline-code">/</span>
        on every platform. If the file sits in none of the workspaces, you get the basename.
      </p>
      <CodeBlock code={workspaces} filename="workspaces.ts" />

      <h2>Overwrite</h2>
      <p>
        The default target is named <span class="inline-code">DEFAULT</span> and overwrites.
        Pass <span class="inline-code">{`{ overwrite: false }`}</span> for a file that should
        exist after the first generation and then belong to the user. On disk the rule is:
      </p>
      <ul>
        <li>Missing file: write it.</li>
        <li>Existing file, same bytes: do nothing. The timestamp does not change.</li>
        <li>Existing file, different bytes, overwrite true: replace it.</li>
        <li>Existing file, different bytes, overwrite false: leave the user's file.</li>
      </ul>
      <p>
        Recording the same path twice with different content, or with a different overwrite
        flag, throws. Generating the same bytes twice is allowed.
      </p>

      <h2>Targets</h2>
      <p>
        A target is a named output tree with its own default overwrite flag. This is the
        same idea as an Xtext outlet: generated sources in one directory, once-only stubs
        in another. The path you pass to <span class="inline-code">createFile</span> is
        relative to whichever directory you later pass to <span class="inline-code">writeToDisk</span>.
      </p>
      <CodeBlock code={targets} filename="targets.ts" />

      <h2>Cleaning the output directory</h2>
      <p>
        <span class="inline-code">writeToDisk</span> does not delete leftovers.
        <span class="inline-code">cleanAndWriteToDisk</span> writes first, then removes
        files in that directory that were not part of this generation. Files whose
        content did not change are not deleted and recreated.
      </p>
      <CodeBlock code={clean} filename="clean.ts" />

      <div class="note">
        <p>
          The generator test runner uses this manager. In verify mode it never writes.
          It compares the in-memory map to the committed tree, including the overwrite
          flag stored in the metadata JSON. See the <a href="/testing/">generator tests guide</a>.
        </p>
      </div>
      <p>
        Types: <a href={`${SITE.typedoc}/classes/generator.GeneratedContentManager.html`}>GeneratedContentManager</a>,
        <a href={`${SITE.typedoc}/interfaces/generator.GeneratorManager.html`}>GeneratorManager</a>,
        <a href={`${SITE.typedoc}/interfaces/generator.CreateFileOptions.html`}>CreateFileOptions</a>.
      </p>
      <div class="next-guides">
        <a href="/testing/">Generator tests →</a>
        <a href="/java/">Java files →</a>
      </div>
    </div>
  </article>
</Base>
