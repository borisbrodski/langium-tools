---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { GUIDES, SITE } from '../lib/site';

const install = `npm install langium-tools`;

const issuesSnippet = `import { getDocumentIssueSummary } from 'langium-tools/base';

const summary = getDocumentIssueSummary(document);
if (summary.countErrors > 0) {
  console.error(summary.message);
  process.exit(1);
}`;

const generatorSnippet = `import { GeneratedContentManager } from 'langium-tools/generator';

const manager = new GeneratedContentManager();

function generate(model: Model) {
  const gen = manager.generatorManagerFor(model);
  gen.createFile('src-gen/model.ts', \`// generated\\nexport const name = '\${model.name}';\\n\`);
  gen.createFile('src/model.ts', \`export const name = '\${model.name}';\\n\`, { overwrite: false });
}

for (const model of models) generate(model);
await manager.writeToDisk('./generated');`;

const testSnippet = `import { langiumGeneratorSuite } from 'langium-tools/testing';

langiumGeneratorSuite('./test-workspaces', {
  createServices: (context) => createMyDslServices(context),
  generateForModel: async (_services, model, gen) => {
    gen.createFile('out/' + model.name + '.ts', render(model));
  },
});`;
---
<Base title="langium-tools — issues, generators, and tests for Langium DSLs">

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div>
        <div class="badges">
          <span class="badge"><span class="dot"></span> v{SITE.version}</span>
          <span class="badge">Langium {SITE.langium}</span>
          <span class="badge">MIT</span>
        </div>
        <h1>The work around the grammar, <span class="brand-text">already built.</span></h1>
        <p class="hero-sub">
          Langium parses, links, validates, and speaks LSP. A real DSL project still needs
          three more things: one way to see every error, a generator that does not thrash the
          filesystem, and tests that pin both. <b>langium-tools</b> is that layer.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#quickstart">Get started</a>
          <a class="btn btn-ghost" href={SITE.github}>View on GitHub</a>
        </div>
        <div class="hero-facts">
          <div><b>5</b><span>import paths</span></div>
          <div><b>170</b><span>tests in this repo</span></div>
          <div><b>4.4</b><span>Langium</span></div>
          <div><b>MIT</b><span>license</span></div>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img src="/img/logo.png" alt="" />
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="why">
    <div class="container">
      <div class="kicker">Why this library</div>
      <h2>Stop rebuilding the same three tools</h2>
      <p class="lead">
        Every Langium grammar eventually grows a CLI, a generator, and a test suite.
        Those pieces look different in every repository, and they drift. This library
        is the shared version, with tests of its own.
      </p>
      <div class="grid2 advantage">
        <article>
          <h3>One list of problems</h3>
          <p>
            Lexer errors, parser errors, and validation diagnostics live on different
            objects, with different position conventions. A CLI that prints only
            <span class="inline-code">document.diagnostics</span> hides syntax errors.
            <span class="inline-code">getDocumentIssues</span> returns all three, and
            <span class="inline-code">getDocumentIssueSummary</span> prints them.
          </p>
        </article>
        <article>
          <h3>Generators that leave quiet files alone</h3>
          <p>
            Writing every file on every run changes timestamps and wakes every watcher
            downstream. Generated content is collected in memory first. A file is
            rewritten only when the bytes differ and overwrite is allowed. Initial
            files can be generated once and then left for the user to edit.
          </p>
        </article>
        <article>
          <h3>Snapshot tests for a tree of files</h3>
          <p>
            A single expected string falls apart once a generator emits dozens of
            files. Commit the <span class="inline-code">generated/</span> directory.
            The test builds the workspace, generates in memory, and compares content
            and the overwrite flag. A real change is approved by regenerating and
            reading the git diff.
          </p>
        </article>
        <article>
          <h3>Markers instead of column arithmetic</h3>
          <p>
            Hard-coded line and column numbers break as soon as the sample DSL gains
            a line. Wrap the offending name in a marker, parse with
            <span class="inline-code">parseWithMarks</span>, and assert the issue
            sits on that span. The markers are stripped before Langium sees the text.
          </p>
        </article>
        <article>
          <h3>Several output trees, one generator</h3>
          <p>
            A language often emits a generated tree and a second tree of files the
            user is allowed to edit. Targets carry their own default overwrite flag.
            The same relative path can be produced twice, into two directories,
            without a second code path.
          </p>
        </article>
        <article>
          <h3>Java files with honest imports</h3>
          <p>
            Package declaration, import list, and body are assembled after the body
            has asked for every class it uses. Two types named <span class="inline-code">List</span>
            do not both become a short name. The collision keeps the fully qualified form.
          </p>
        </article>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="fit">
    <div class="container">
      <div class="kicker">Where it fits</div>
      <h2>Langium still owns the language</h2>
      <p class="lead">
        You keep your grammar, your services, and your language server. langium-tools
        reads documents Langium already built, and it writes files your generator decides on.
      </p>
      <ol class="flow">
        <li><b>DSL text</b><span>files in a workspace, or a string in a test</span></li>
        <li><b>Langium</b><span>lex, parse, link, validate</span></li>
        <li><b>Your generator</b><span>walk the AST, decide the files</span></li>
        <li><b>Disk</b><span>only the files that actually changed</span></li>
      </ol>
      <div class="hooks">
        <div><b>Issues</b> read the document after parsing and validation.</div>
        <div><b>Matchers</b> assert those issues, optionally on a marker in the sample.</div>
        <div><b>GeneratedContentManager</b> sits between the generator and the disk.</div>
        <div><b>langiumGeneratorSuite</b> runs the whole path and compares the tree.</div>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="quickstart">
    <div class="container">
      <div class="kicker">Getting started</div>
      <h2>Install it next to Langium</h2>
      <p class="lead">
        The package is ESM. Imports are subpaths, so a project that only checks
        diagnostics does not pull in the generator. The testing entry registers
        Vitest matchers and expects Vitest 2.
      </p>
      <CodeBlock code={install} lang="bash" filename="terminal" />
      <div class="grid2" style="margin-top: 22px;">
        <div>
          <h3>Fail the CLI when the document is wrong</h3>
          <CodeBlock code={issuesSnippet} filename="cli.ts" />
        </div>
        <div>
          <h3>Generate, then write</h3>
          <CodeBlock code={generatorSnippet} filename="generator.ts" />
        </div>
      </div>
      <h3 style="margin-top: 28px;">Lock the generator output in CI</h3>
      <p>
        Default mode compares against the committed tree. Set
        <span class="inline-code">GENERATOR_TEST=generate</span> when you intend to update it.
      </p>
      <CodeBlock code={testSnippet} filename="generator.test.ts" />
      <p class="after-code">
        Each guide below is a full walkthrough: the API, the options, and a copy-paste example.
        The generated Typedoc reference is published with this site at <a href={SITE.typedoc}>/api</a>.
      </p>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="modules">
    <div class="container">
      <div class="kicker">Modules</div>
      <h2>Everything the library actually contains</h2>
      <p class="lead">Six guides. The public surface is five import paths.</p>
      <div class="grid3">
        {GUIDES.map((guide) => (
          <a class="card" href={guide.href}>
            <h3>{guide.title}</h3>
            <p>{guide.blurb}</p>
            <span class="more">Read the guide →</span>
          </a>
        ))}
      </div>
      <div class="exports">
        <div><span class="inline-code">langium-tools/base</span><span>issues, templates, markers, sorting</span></div>
        <div><span class="inline-code">langium-tools/generator</span><span>in-memory files and disk writer</span></div>
        <div><span class="inline-code">langium-tools/testing</span><span>Vitest matchers and generator suites</span></div>
        <div><span class="inline-code">langium-tools/lang</span><span>namespace that exposes <span class="inline-code">java</span></span></div>
        <div><span class="inline-code">langium-tools/lang/java</span><span>imports and Java file layout</span></div>
      </div>
    </div>
  </section>

  <style>
    .hero { position: relative; overflow: hidden; }
    :root[data-theme='light'] .hero-glow { display: none; }
    .hero-glow {
      position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(560px 300px at 82% 30%, rgba(26,175,150,.16), transparent 65%),
        radial-gradient(480px 280px at 70% 80%, rgba(94,240,212,.08), transparent 60%);
    }
    .hero-grid {
      position: relative; display: grid; grid-template-columns: 1.3fr .7fr;
      gap: 40px; align-items: center; padding-top: 76px; padding-bottom: 76px;
    }
    .badges { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
    .hero-sub { font-size: 1.12rem; max-width: 560px; margin: 18px 0 28px; }
    .hero-sub b { color: var(--text); }
    .hero-cta { display: flex; gap: 14px; margin-bottom: 40px; flex-wrap: wrap; }
    .hero-facts { display: flex; gap: 36px; flex-wrap: wrap; }
    @media (max-width: 520px) {
      .hero-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; }
    }
    .hero-facts div { display: flex; flex-direction: column; }
    .hero-facts b { font-size: 1.45rem; font-weight: 750; letter-spacing: -.02em; color: var(--text); }
    .hero-facts span { font-size: .82rem; color: var(--text-3); }
    .hero-art {
      display: flex; align-items: center; justify-content: center;
    }
    .hero-art img {
      width: min(280px, 100%);
      border-radius: 28px;
      background: radial-gradient(circle at 50% 45%, rgba(94,240,212,.12), transparent 70%);
    }
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; padding-top: 48px; padding-bottom: 48px; }
      .hero-art { display: none; }
    }

    .advantage article {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
    }
    .advantage h3 { margin-bottom: 8px; }
    .advantage p { margin: 0; font-size: .95rem; }

    .flow {
      list-style: none; padding: 0; margin: 0 0 22px;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
    }
    .flow li {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 16px 16px 14px; display: flex; flex-direction: column; gap: 4px; position: relative;
    }
    .flow li b { color: var(--text); }
    .flow li span { color: var(--text-3); font-size: .84rem; }
    .flow li::before {
      content: ''; position: absolute; top: 22px; right: -12px; width: 12px; height: 1px; background: var(--border-strong);
    }
    .flow li:last-child::before { display: none; }
    @media (max-width: 800px) {
      .flow { grid-template-columns: 1fr; }
      .flow li::before { display: none; }
    }
    .hooks { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; }
    .hooks div {
      padding: 12px 14px; border: 1px solid var(--border); border-radius: 10px;
      background: var(--surface); color: var(--text-2); font-size: .92rem;
    }
    .hooks b { color: var(--text); }
    .hooks b::before {
      content: '▸ ';
      background: var(--brand-grad);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    @media (max-width: 800px) { .hooks { grid-template-columns: 1fr; } }

    .after-code { margin-top: 8px; }
    .exports { margin-top: 28px; display: grid; gap: 8px; }
    .exports div {
      display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap;
      padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface);
      color: var(--text-3); font-size: .9rem;
    }
  </style>
</Base>
